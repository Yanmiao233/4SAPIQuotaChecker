<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="QuotaChecker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QuotaChecker.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片外观 -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
