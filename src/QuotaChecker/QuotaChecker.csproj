<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>QuotaChecker</RootNamespace>
    <AssemblyName>QuotaChecker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- 免安装（unpackaged）：直接双击 exe 运行，无需部署 MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- 按 Platform 推导 RuntimeIdentifier，使 dotnet build / publish 无需手动指定 -r -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 裁剪发布体积：166 MB -> 约 85 MB（仅影响 publish，dotnet build 不受影响） -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- WinUI / CsWinRT 依赖内置 COM 互操作；裁剪会默认关闭它，导致启动即崩溃 (0xC000027B) -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 反射式 JSON 兜底；本项目自身已改用源生成序列化 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!--
    CsWinRT 在运行时通过反射计算 COM 接口表（见 WinRT.ComWrappersSupport.GetInterfaceTableEntries）。
    这些类型一旦被裁掉，设置 ListView.ItemsSource 之类的操作就会抛 NullReferenceException 并崩溃 (0xC000027B)。
    因此把参与 WinRT 互操作的程序集整体保留，只让 BCL 接受裁剪。
  -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
    <TrimmerRootAssembly Include="QuotaChecker" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- 提供 PRI/XAML 生成所需的 MSBuild 任务，使仅安装 .NET SDK（无 Visual Studio）也能构建 -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261008100" />
  </ItemGroup>

</Project>
